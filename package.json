{
  "name": "hydration-multiplayer-edition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev --port 8787 --var APP_ORIGIN:http://localhost:5173",
    "check:worker": "tsc -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply hydratation-multiplayer-edition --local",
    "db:migrate:remote": "wrangler d1 migrations apply hydratation-multiplayer-edition --remote",
    "types:worker": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "wrangler": "^4.168.0",
    "@types/node": "^26.6.11"
  }
}
